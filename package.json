{
  "name": "ai-work-memory",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "wxt",
    "prepare": "wxt prepare",
    "build": "pnpm build:chrome && pnpm build:edge",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
